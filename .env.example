# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_incubator"

# NextAuth (Incubator web app)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"

# OpenAI (required — plan generation, embeddings, Realtime voice teacher)
OPENAI_API_KEY="sk-..."

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Praxo (see docs/praxo/PLAN.md)
# Shared secret the native Mac app sends as "Authorization: Bearer <token>".
# Any long random string; must match the client's configured token.
PRAXO_DEVICE_TOKEN=""
# Access codes for the web app at /praxo — comma-separated, min 6 chars each.
# Give one code per learner; the code IS their identity (same code = same progress).
PRAXO_ACCESS_CODES="praxo-founder-2026"
# Password for the admin dashboard at /praxo/admin.
PRAXO_ADMIN_PASSWORD=""
# Cost guardrail: max voice sessions per learner per day (default 10).
PRAXO_MAX_SESSIONS_PER_DAY="10"
# Optional overrides
PRAXO_REALTIME_MODEL="gpt-realtime"
PRAXO_TEACHER_VOICE="marin"
